{
  "name": "dadam-cabinet",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/check-site-assets.mjs",
    "asset-version": "node scripts/stamp-asset-version.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:report": "node scripts/lint-report.mjs",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,css,md,html}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run format:check && npm run typecheck",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate:html": "html-validate \"*.html\" \"admin/*.html\"",
    "check:links": "linkinator \"*.html\" --skip \"^(?!http)\" --timeout 10000"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-validate": "^8.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jimp": "^0.22.12",
    "linkinator": "^6.0.4",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.1"
  }
}
